# Copiar a .env y rellenar los valores reales
# ─────────────────────────────────────────────

# Base de datos
POSTGRES_PASSWORD=cambia_esto_por_algo_seguro
DATABASE_URL=postgresql://fastit:cambia_esto_por_algo_seguro@db:5432/fastit

# Seguridad JWT — generarlo con: openssl rand -hex 32
SECRET_KEY=genera_con__openssl_rand_hex_32

# URLs de la aplicación
BACKEND_URL=https://tu-dominio.cl
FRONTEND_URL=https://tu-dominio.cl

# Admin bootstrap
ADMIN_BOOTSTRAP_PASSWORD=cambia_esto

# ── OpenAI (Advisor IA) ────────────────────────────────────────────────────────
# Obtener en: platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── SendGrid (correos de verificación y reset de contraseña) ──────────────────
# Obtener en: app.sendgrid.com → Settings → API Keys
# El remitente debe estar verificado como Single Sender o dominio autenticado
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@tu-dominio.cl

# ── Transbank WebpayPlus (pasarela de pago principal) ────────────────────────
# Solicitar credenciales reales en: developers.transbank.cl
# Mientras tanto, los valores de abajo son los del sandbox público de Transbank
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENV=test
# Cambiar TRANSBANK_ENV=production con tus credenciales reales cuando estés listo

# ── Flow.cl (pasarela alternativa — actualmente desactivada) ─────────────────
# Registrarse en: sandbox.flow.cl para obtener credenciales de prueba
# Producción en: www.flow.cl
FLOW_API_KEY=FLOW_API_KEY_AQUI
FLOW_SECRET=FLOW_SECRET_AQUI
FLOW_API_URL=https://sandbox.flow.cl/api

# ── Chilexpress (cotización y despacho) ───────────────────────────────────────
# Solicitar acceso en: developers.chilexpress.cl
# Requiere cuenta empresarial con Chilexpress
CHILEXPRESS_API_KEY=
CHILEXPRESS_BASE_URL=https://testservices.wschilexpress.com
# Producción: https://services.wschilexpress.com

# ── Icecat (enriquecimiento de fichas de producto) ───────────────────────────
# Registro gratuito en: icecat.biz → My Icecat → Account
ICECAT_USERNAME=
